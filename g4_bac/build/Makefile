	$(MAKE) $(MAKESILENT) -f CMakeFiles/main.dir/build.make CMakeFiles/main.dir/src/MPPCSD.cc.i
.PHONY : src/MPPCSD.cc.i

src/MPPCSD.s: src/MPPCSD.cc.s
.PHONY : src/MPPCSD.s

# target to generate assembly for a file
src/MPPCSD.cc.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/main.dir/build.make CMakeFiles/main.dir/src/MPPCSD.cc.s
.PHONY : src/MPPCSD.cc.s

